erDiagram
  USER ||--o{ TASK : "создаёт"
  USER ||--o{ TASK : "исполняет"
  USER ||--o{ COMMENT : "пишет"
  TASK ||--o{ COMMENT : "содержит"

  USER {
    int id PK
    string email
    string full_name
    string password_hash
    string role
    bool is_active
    datetime created_at
  }
  TASK {
    int id PK
    string title
    string description
    string status
    string priority
    int author_id FK
    int assignee_id FK
    datetime created_at
    datetime updated_at
    datetime completed_at
  }
  COMMENT {
    int id PK
    int task_id FK
    int author_id FK
    string body
    datetime created_at
  }
